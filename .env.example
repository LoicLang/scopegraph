# scopegraph — LLM configuration (copy to .env; .env is gitignored).
# The app runs fully without any of this: SCOPEGRAPH_LLM_PROVIDER=none gives the
# deterministic template mode (no key, no network). A provider only adds the polish.

# Which provider drives the LLM steps: none | mock | mistral | deepseek | grok | gemini
SCOPEGRAPH_LLM_PROVIDER=mistral

# API keys — only the one matching the provider above is needed.
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
