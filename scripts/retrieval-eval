#!/usr/bin/env python3
"""Layer-2 quality bench: play scoping scenarios through the REAL retriever (never in CI).

Unlike the hermetic pytest suite (mechanics, rigged embedder), this bench measures retrieval
QUALITY with the real model against a hand-derived ground truth: per-scenario critical-node
recall, map size, and precision. Findings from the 2026-06-11 run are recorded in
docs/known-limits.md — re-run this after any constants change and update that doc.

Usage:
    pip install -e ".[embeddings]"
    ./scripts/retrieval-eval                        # per-scenario report at current config
    ./scripts/retrieval-eval --sweep                # recall/size/precision across threshold grids
    ./scripts/retrieval-eval --distractors N        # merge N pool distractors before running
    ./scripts/retrieval-eval --distractor-sweep     # run at N=0,500,1000,2000 and print verdict
    ./scripts/retrieval-eval --embedder NAME        # any PROFILES key (default: DEFAULT_PROFILE)
    ./scripts/retrieval-eval --top-n {fixed,scaled} # override profile TOP_N policy
    ./scripts/retrieval-eval --grid                 # run 2x2 grid (embedder x top-n) as full sweeps
"""

import argparse
import statistics
import sys
from dataclasses import dataclass, field, replace as dc_replace
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from core.graph.service import GraphService  # noqa: E402
from core.retrieval import config  # noqa: E402
from core.retrieval.config import PROFILES, RetrievalProfile  # noqa: E402
from core.retrieval.index import VectorIndex  # noqa: E402
from core.retrieval.retriever import retrieve  # noqa: E402
from core.retrieval.st_embedder import SentenceTransformersEmbedder  # noqa: E402

from core.benchdata.scenarios import SCENARIOS  # noqa: E402

BRIEFS = {name: brief for name, brief, _, _ in SCENARIOS}

GRIDS = [
    ("baseline W2", 0.35, 0.20, 8, 2),
    ("tight+", 0.40, 0.28, 6, 2),
    ("tight++", 0.45, 0.32, 5, 2),
    ("aggressive", 0.48, 0.38, 4, 2),
    ("1-hop tight++", 0.45, 0.32, 5, 1),
]

SWEEP_POINTS = [0, 500, 1000, 2000]


def resolve_profile(name: str, top_n: str | None) -> RetrievalProfile:
    profile = PROFILES[name]
    if top_n is not None:
        profile = dc_replace(profile, top_n_policy="coverage" if top_n == "scaled" else "fixed")
    return profile


@dataclass
class RunSummary:
    recall: float
    size: float
    precision: float
    found: dict[str, set[str]] = field(default_factory=dict)  # scenario -> expected hits
    thieves: dict[str, list[tuple[str, str, tuple[str, ...], float]]] = field(
        default_factory=dict
    )  # scenario -> [(id, title, domains, sim)] for distractor anchors


@dataclass
class CellResult:
    holds: bool
    base_recall: float
    worst_recall: float


def run_cases(service: GraphService, index: VectorIndex, profile: RetrievalProfile) -> RunSummary:
    distractor_ids = {n.id for n in service.all_nodes() if n.created_from == "synthetic"}
    total = len(service.all_nodes())
    recalls, sizes, precisions = [], [], []
    found: dict[str, set[str]] = {}
    thieves: dict[str, list] = {}
    for name, brief, expected, trap in SCENARIOS:
        result = retrieve(brief, service, index, profile=profile)
        got = set(result.node_ids())
        hit = expected & got
        found[name] = hit
        recalls.append(len(hit) / len(expected))
        sizes.append(len(got))
        precisions.append(len(hit) / max(len(got), 1))
        missing = ", ".join(sorted(expected - got)) or "-"
        line = f"  {name:30s} recall {len(hit)}/{len(expected)}  map {len(got):3d}/{total}"
        if distractor_ids:
            intrusion = sum(1 for a in result.anchors if a.node_id in distractor_ids)
            pollution = len(got & distractor_ids) / max(len(got), 1)
            line += (f"  anchor-intrusion {intrusion}/{len(result.anchors)}"
                     f"  pollution {pollution:.0%}")
            found_thieves = []
            for scored in result.anchors:
                if scored.node_id in distractor_ids:
                    node = service.get_node(scored.node_id)
                    title = getattr(node, "name", "") or getattr(node, "title", "")
                    found_thieves.append(
                        (scored.node_id, title, tuple(node.domains), scored.semantic_sim or 0.0)
                    )
            thieves[name] = found_thieves
        print(f"{line}  missing: {missing}")
        if expected - got:
            print(f"    trap: {trap}")
    n = len(SCENARIOS)
    return RunSummary(sum(recalls) / n, sum(sizes) / n, sum(precisions) / n, found, thieves)


def build_service(n: int) -> GraphService:
    if n == 0:
        return GraphService.from_dir(ROOT / "graph")
    return GraphService.from_dirs(ROOT / "graph", ROOT / "graph-distractors", n)


def realism_check(service: GraphService, index: VectorIndex) -> None:
    """Brief↔distractor sims vs brief↔seed-noise sims: warn when the pool is easy noise.

    Real seed noise sits at ≈0.25-0.40 (known-limits L1). If the distractors' median
    similarity sits well below the seed noise median, the pool does not exert real
    anchor pressure and the verdict cannot be trusted.
    """
    distractor_ids = {n.id for n in service.all_nodes() if n.created_from == "synthetic"}
    if not distractor_ids:
        return
    total = len(service.all_nodes())
    pool_sims: list[float] = []
    noise_sims: list[float] = []
    for _, brief, expected, _ in SCENARIOS:
        for node_id, sim in index.query(brief, total):
            if node_id in distractor_ids:
                pool_sims.append(sim)
            elif node_id not in expected:
                noise_sims.append(sim)

    def dist(values: list[float]) -> str:
        q1, med, q3 = statistics.quantiles(values, n=4)
        return f"q1 {q1:.2f} med {med:.2f} q3 {q3:.2f} max {max(values):.2f}"

    print(f"  realism: distractors [{dist(pool_sims)}] vs seed noise [{dist(noise_sims)}]")
    if statistics.median(pool_sims) < statistics.median(noise_sims) - 0.05:
        print("  WARNING: distractor sims sit well below real seed noise — the pool is"
              " too easy, this verdict is not trustworthy")


def print_verdict(base: RunSummary, worst: RunSummary, service: GraphService) -> bool:
    """Criterion fixed BEFORE measurement (spec §6): per-case survival + mean drop ≤10pts."""
    dead = {
        name: sorted(base.found[name] - worst.found[name])
        for name in base.found
        if base.found[name] - worst.found[name]
    }
    drop = base.recall - worst.recall
    print(f"\nrecall N=0 {base.recall:.0%} -> N={SWEEP_POINTS[-1]} {worst.recall:.0%}"
          f" (drop {drop:.0%})")
    if not dead and drop <= 0.10:
        print("VERDICT: HOLDS — no per-case regression, mean drop within 10 pts")
        return True
    print("VERDICT: TRAPS DIE — read the autopsy, then spec §5 annotation before escalating")
    for name, nodes in sorted(dead.items()):
        dead_domains = {d for node_id in nodes for d in service.get_node(node_id).domains}
        print(f"  {name}: lost {', '.join(nodes)}")
        print(f"    brief: {BRIEFS[name]}")
        for thief_id, title, domains, sim in worst.thieves.get(name, []):
            flag = "same-domain" if set(domains) & dead_domains else "cross-domain"
            print(f"    thief [{flag}] {thief_id} (sim {sim:.3f}) — {title} {list(domains)}")
    return False


def distractor_sweep(embedder: SentenceTransformersEmbedder, profile: RetrievalProfile) -> CellResult:
    runs: dict[int, RunSummary] = {}
    services: dict[int, GraphService] = {}
    for n in SWEEP_POINTS:
        service = build_service(n)
        services[n] = service
        index = VectorIndex(embedder)
        index.build(service)
        top_n = profile.top_n(len(service.all_nodes()))
        print(f"\n--- distractors N={n} ({len(service.all_nodes())} nodes,"
              f" top_n {top_n}) ---")
        realism_check(service, index)
        runs[n] = run_cases(service, index, profile)
        print(f"==> recall {runs[n].recall:.0%} | map {runs[n].size:.1f}"
              f" | precision {runs[n].precision:.0%}")
    verdict_bool = print_verdict(runs[0], runs[max(SWEEP_POINTS)], services[max(SWEEP_POINTS)])
    return CellResult(holds=verdict_bool, base_recall=runs[0].recall, worst_recall=runs[max(SWEEP_POINTS)].recall)


# Grid rows: the frozen baseline + the gate-passing candidate (e5 was rejected at
# the N=0 gate, 2026-06-12 — kept in PROFILES for reproducibility, not re-stressed).
GRID_EMBEDDERS = ("minilm", "qwen3")


def run_grid() -> None:
    """Spec §5: the four cells, each a full sweep; one embedder load per row."""
    outcomes: dict[str, CellResult | None] = {}
    for embedder_name in GRID_EMBEDDERS:
        # one load per row: --top-n resolution only changes top_n_policy, never embedding identity
        embedder = SentenceTransformersEmbedder(PROFILES[embedder_name])
        for top_n in ("fixed", "scaled"):
            cell = f"{embedder_name} × top-n {top_n}"
            print(f"\n{'=' * 20} CELL {cell} {'=' * 20}")
            try:
                outcomes[cell] = distractor_sweep(embedder, resolve_profile(embedder_name, top_n))
            except Exception as exc:  # a dead cell must not eat the others' hour of compute
                print(f"CELL CRASHED: {exc!r}")
                outcomes[cell] = None
    print("\n===== GRID SUMMARY =====")
    for cell, result in outcomes.items():
        if result is None:
            print(f"  {cell:28s} CRASHED")
        else:
            status = "HOLDS" if result.holds else "TRAPS DIE"
            print(f"  {cell:28s} {status}  recall {result.base_recall:.0%} -> {result.worst_recall:.0%}")


def main() -> None:
    sys.stdout.reconfigure(line_buffering=True)  # tee-friendly: a 60-min grid run must stream, and a hard crash must not eat output
    parser = argparse.ArgumentParser()
    parser.add_argument("--sweep", action="store_true", help="run the threshold grid sweep")
    parser.add_argument("--distractors", type=int, default=0, metavar="N",
                        help="merge the first N pool distractors before running")
    parser.add_argument("--distractor-sweep", action="store_true",
                        help=f"run at N={SWEEP_POINTS} and print the verdict")
    parser.add_argument("--embedder", choices=sorted(PROFILES), default=None,
                        help="profile to run (default: DEFAULT_PROFILE)")
    parser.add_argument("--top-n", choices=["fixed", "scaled"], default=None,
                        help="override the profile's TOP_N policy")
    parser.add_argument("--grid", action="store_true",
                        help="run the 2x2 grid (embedder x top-n policy) as full sweeps")
    args = parser.parse_args()

    if args.grid:
        run_grid()
        return

    name = args.embedder or config.DEFAULT_PROFILE.name
    profile = resolve_profile(name, args.top_n)
    embedder = SentenceTransformersEmbedder(profile)

    if args.distractor_sweep:
        distractor_sweep(embedder, profile)
        return

    service = build_service(args.distractors)
    index = VectorIndex(embedder)
    index.build(service)

    if not args.sweep:
        print(f"profile: {profile.name}  tau_anchor={profile.tau_anchor}"
              f" tau_keep={profile.tau_keep} top_n_policy={profile.top_n_policy}"
              f" TOP_K={config.TOP_K} MAX_HOPS={config.MAX_HOPS}")
        summary = run_cases(service, index, profile)
        print(f"\n  mean recall {summary.recall:.0%} | mean map {summary.size:.1f}"
              f" | mean precision {summary.precision:.0%}")
        return

    print(f"{'grid':14s} TAU_A TAU_K K hops | recall | map   | precision")
    for grid_name, tau_a, tau_k, top_k, hops in GRIDS:
        grid_profile = dc_replace(profile, tau_anchor=tau_a, tau_keep=tau_k)
        config.TOP_K, config.MAX_HOPS = top_k, hops
        print(f"\n--- {grid_name} ---")
        summary = run_cases(service, index, grid_profile)
        print(f"==> recall {summary.recall:.0%} | map {summary.size:.1f}"
              f" | precision {summary.precision:.0%}")


if __name__ == "__main__":
    main()
